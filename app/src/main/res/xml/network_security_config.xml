<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- PLC 用 http://IP:80 明文传输，Android 9+ 默认禁止，这里放开 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
